#!name = YouTube Enhance 与 DualSubs 完整功能
#!desc = 去广告 / 自动高清 / UI 精简 + DualSubs 双语字幕与 YouTube Music 歌词翻译\n由 Anywhere YouTubeEnhanceDualSubsFull.amrs 转换
#!openUrl = https://dualsubs.github.io/settings/
#!author = gholts, VirgilClyne
#!icon = https://github.com/DualSubs/YouTube/raw/main/src/assets/icon_rounded.png
#!tag = YouTube,字幕,去广告,Music
#!system = iOS,iPadOS,macOS
#!date = 2026-10-13

[Argument]
# ---------- gholts Enhance ----------
blockUpload = switch,true,tag=隐藏上传入口,desc=隐藏导航中的上传入口
blockShorts = switch,false,tag=隐藏 Shorts 入口,desc=隐藏导航中的 Shorts 入口
autoHd = switch,true,tag=自动高清,desc=优先最高可用视频清晰度并防止自动降级
blockGames = switch,true,tag=隐藏游戏推荐,desc=隐藏 Playables 游戏推荐卡片
blockVerticalLive = switch,false,tag=隐藏竖屏直播,desc=隐藏已识别的竖屏直播推荐
jumpAhead = switch,true,tag=启用 Jump Ahead,desc=启用原生跳过按钮并去除推广提示
blockStore = switch,true,tag=隐藏商店与购物,desc=隐藏创作者商店和视频购物组件
blockAi = switch,true,tag=隐藏 AI 功能,desc=隐藏 Ask 和 AI 摘要等控件
# ---------- DualSubs 字幕 / 歌词 ----------
Type = select,"Translate","Official",tag=[字幕] 启用类型,desc=Translate=翻译字幕 / Official=官方合成字幕
Types = input,"Translate",tag=[歌词] 启用类型,desc=YouTube Music 歌词：填 Translate
AutoCC = switch,true,tag=[字幕] 自动显示,desc=是否总是自动开启字幕显示
Position = select,"Forward","Reverse",tag=[字幕] 原文位置,desc=Forward=原文在上 / Reverse=原文在下
Vendor = select,"Google","Microsoft",tag=[翻译器] 服务商,desc=翻译 API（更多选项见 BoxJs / 设置面板）
ShowOnly = switch,false,tag=只显示自动翻译字幕,desc=true=仅译文，false=双语
Storage = select,"PersistentStore","Argument","database",tag=[储存] 配置类型,desc=配置读取优先级
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=脚本日志输出等级

[Rule]
# 广告 initplayback / pagead / stats
URL-REGEX,^https?://[\w-]+\.googlevideo\.com/initplayback(\?.*oad=.+)$,REJECT
URL-REGEX,^https://www\.youtube\.com/(pagead|pcs)/,REJECT
URL-REGEX,^https://s\.youtube\.com/api/stats/ads,REJECT

[Rewrite]
# DualSubs 在线设置面板
response if ${url} ~= /^https:\/\/dualsubs\.github\.io\/api\/YouTube(?:\?.*)?$/i then response.body.mock_file("json", "https://github.com/DualSubs/YouTube/releases/download/v1.6.0/DualSubs.YouTube.PreferencePanes.json", 200) | response.header.add(["X-PreferencePanes-Version", "Cache-Control"], ["1.6.0", "no-store"])
# timedtext：tlang → subtype=Translate（与 amrs rewrite 对应）
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$2&$4&subtype=Translate$5 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ https://$1$2&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$3&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)(#.*)?$ https://$1subtype=Translate$3 302

[Script]
# ==================== gholts Enhance ====================
# ad_break 空响应
http-request ^https://youtubei\.googleapis\.com/youtubei/v1/player/ad_break(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js, timeout=15, tag=YT.Enhance.ad-break

# googlevideo init / videoplayback 请求（密钥 / 自动高清）
http-request ^https?://[\w-]+\.googlevideo\.com/(?:initplayback|videoplayback)(?:\?.*)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js, timeout=15, tag=YT.Enhance.playback-req, argument={"autoHd":{autoHd}}

# log_event 请求
http-request ^https://youtubei\.googleapis\.com/youtubei/v1/log_event(?:\?.*)?$ script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/request.js, timeout=15, tag=YT.Enhance.log-event

# 主 UI / 播放响应增强（去广告、隐藏入口、画质等）
http-response ^https://youtubei\.googleapis\.com/youtubei/v1/(?:navigation/resolve_url|browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?.*)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/response.js, timeout=30, tag=YT.Enhance.response, argument={"blockUpload":{blockUpload},"blockShorts":{blockShorts},"blockGames":{blockGames},"blockVerticalLive":{blockVerticalLive},"jumpAhead":{jumpAhead},"autoHd":{autoHd},"blockStore":{blockStore},"blockAi":{blockAi}}

# config / log_event 响应（密钥相关）
http-response ^https://youtubei\.googleapis\.com/youtubei/v1/(?:config|log_event)(?:\?.*)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/key.js, timeout=20, tag=YT.Enhance.key

# initplayback 响应（UMP）
http-response ^https?://[\w-]+\.googlevideo\.com/initplayback(?:\?.*)?$ requires-body=1, binary-body-mode=1, script-path=https://raw.githubusercontent.com/gholts/surge/main/scripts/youtube/ump.js, timeout=30, tag=YT.Enhance.ump, argument={"blockGames":{blockGames},"blockVerticalLive":{blockVerticalLive},"jumpAhead":{jumpAhead},"autoHd":{autoHd},"blockStore":{blockStore},"blockAi":{blockAi}}

# ==================== DualSubs：YouTube 字幕 ====================
http-request ^https?://(www|m|tv)\.youtube\.com/youtubei/v1/player(\?.+)?$ requires-body=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, timeout=20, tag=DualSubs.YT.Player.req.json, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?://(www|m|tv)\.youtube\.com/youtubei/v1/player(\?.+)?$ requires-body=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/response.bundle.js, timeout=30, tag=DualSubs.YT.Player.res.json, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

http-request ^https?://youtubei\.googleapis\.com/youtubei/v1/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, timeout=20, tag=DualSubs.YT.Player.req.proto, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?://youtubei\.googleapis\.com/youtubei/v1/player(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/response.bundle.js, timeout=30, tag=DualSubs.YT.Player.res.proto, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

http-request ^https?://(www|m)\.youtube\.com/api/timedtext(\?.+)?$ script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, timeout=15, tag=DualSubs.YT.TimedText.req, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?://(www|m)\.youtube\.com/api/timedtext\?(.*)subtype=(Official|External) requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Composite.Subtitles.response.bundle.js, timeout=30, tag=DualSubs.YT.Composite.TimedText, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?://(www|m)\.youtube\.com/api/timedtext\?(.*)subtype=Translate requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js, timeout=30, tag=DualSubs.YT.Translate.TimedText, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

# ==================== DualSubs：YouTube Music 歌词 ====================
http-request ^https?://music\.youtube\.com/youtubei/v1/browse(\?.+)?$ requires-body=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, timeout=20, tag=DualSubs.YTMusic.Browse.req.json, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-request ^https?://youtubei\.googleapis\.com/youtubei/v1/browse(\?.+)?$ requires-body=1, binary-body-mode=1, script-path=https://github.com/DualSubs/YouTube/releases/download/v1.6.0/request.bundle.js, timeout=20, tag=DualSubs.YTMusic.Browse.req.proto, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?://music\.youtube\.com/youtubei/v1/browse\?(.*)subtype=Translate requires-body=1, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js, timeout=30, tag=DualSubs.YTMusic.Translate.Lyrics.json, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]
http-response ^https?://youtubei\.googleapis\.com/youtubei/v1/browse\?(.*)subtype=Translate requires-body=1, binary-body-mode=1, script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js, timeout=30, tag=DualSubs.YTMusic.Translate.Lyrics.proto, argument=[{Type},{Types},{AutoCC},{Position},{Vendor},{ShowOnly},{Storage},{LogLevel}]

[MITM]
hostname = %APPEND% dualsubs.github.io, www.youtube.com, m.youtube.com, tv.youtube.com, music.youtube.com, youtubei.googleapis.com, s.youtube.com, *.googlevideo.com
