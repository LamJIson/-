#!name=YouTube 增强
#!desc=去除油管广告 / 支持后台播放 / 画中画 / 自动最高画质
#!author=gholts
#!homepage=https://github.com/gholts/surge/tree/main/modules
#!icon=https://iili.io/KQ67Yxa.png
#!tag=YouTube,去广告,增强

[Argument]
blockUpload = switch,true,tag=隐藏「上传」入口,desc=隐藏导航栏中的「上传」入口
blockShorts = switch,true,tag=隐藏「Shorts」入口,desc=隐藏导航栏中的「Shorts」入口
autoHd = switch,true,tag=自动最高画质,desc=优先使用最高可用画质，并阻止自动降低画质
blockGames = switch,true,tag=隐藏小游戏推荐,desc=隐藏 YouTube Playables（小游戏）推荐
blockVerticalLive = switch,true,tag=隐藏竖屏直播推荐,desc=隐藏各界面中的竖屏直播推荐
jumpAhead = switch,true,tag=启用 Jump Ahead,desc=启用原生「Jump Ahead」跳转按钮，并去除其推广提示
blockStore = switch,true,tag=隐藏商店和购物板块,desc=隐藏视频下方和频道主页中的创作者商店、购物板块
nativeDownload = switch,true,tag=原生下载（实验性）,desc=实验性原生下载；未设置画质时使用 720p，服务器限制可能仍生效
subtitle_type = select,"Translate","Official",tag=[字幕] 启用类型,desc=Translate=自动翻译 / Official=官方字幕
auto_cc = switch,true,tag=[字幕] 自动显示,desc=是否总是自动开启字幕
show_only_auto_translation = switch,false,tag=[翻译器] 只显示译文,desc=true=仅译文，false=双语

subtitle_diagnostics = switch, true, tag=字幕诊断日志, desc=测试期每阶段15秒最多一条，不记录字幕或凭据。
subtitle_cache_size = input, 20, tag=字幕缓存数量, desc=0关闭；最多100个结果，歌词缓存另限128KiB。
subtitle_source_language = input, auto, tag=原文语言, desc=auto从字幕请求读取语言；例如en或zh-CN。
subtitle_target_language = input, zh-CN, tag=默认目标语言, desc=字幕请求已选语言优先；例如zh-CN或en。
subtitle_position = select, "Forward","Reverse", tag=字幕顺序, desc=原文在前或译文在前。
subtitle_tolerance_ms = input, 100, tag=合成时间容差, desc=官方或外挂字幕对齐容差；0至5000毫秒。
subtitle_offset_ms = input, 0, tag=副轨时间偏移, desc=正值延后副轨；范围负60000至60000毫秒。
translation_vendor = select, "Google","GoogleCloud","Microsoft","DeepL", tag=翻译引擎, desc=商业引擎需填写对应认证。
translation_attempts = select, "1","2","3","4", tag=翻译尝试次数, desc=包括首次请求最多4次。
googlecloud_version = select, "v2","v3", tag=Google Cloud版本, desc=v3需要项目ID及OAuth Token。
googlecloud_mode = select, "Key","Token", tag=Google Cloud v2认证, desc=仅v2使用此选项；v3使用OAuth Token。
googlecloud_auth = input, , tag=Google Cloud认证, desc=填入v2 Key或OAuth Token。
googlecloud_project = input, , tag=Google Cloud项目ID, desc=v3必填。
microsoft_version = select, "Azure","AzureCN","AzureUS", tag=Microsoft服务, desc=选择区域服务端。
microsoft_mode = select, "Key","Token", tag=Microsoft认证方式, desc=选择Key或Bearer Token。
microsoft_auth = input, , tag=Microsoft认证, desc=对应Key或Token。
microsoft_region = input, global, tag=Microsoft区域, desc=Key认证的订阅区域。
deepl_version = select, "Free","Pro", tag=DeepL服务, desc=选择Free或Pro。
deepl_auth = input, , tag=DeepL Key, desc=填写DeepL认证Key。
lyrics_translation = switch, true, tag=歌词翻译, desc=翻译YouTube Music已返回的歌词；不改变歌曲信息。
external_subtitle_url = input, , tag=外挂字幕URL, desc=External模式使用；格式需与主轨相同。

[Rewrite]
# 广告相关直接 404
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ - reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads - reject
# timedtext：把 tlang 改写为 subtype=Translate，供字幕脚本识别
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$2&$4&subtype=Translate$5 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ https://$1$2&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$3&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)(#.*)?$ https://$1subtype=Translate$3 302

[Script]
# 1) 空响应拦截 ad_break（请求阶段）
http-request ^https://youtubei\.googleapis\.com/youtubei/v1/player/ad_break(?:\?.*)?$ script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/youtube-ad-break.js, requires-body=false, timeout=10, tag=YT-ad_break

# ad_break 空响应
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$ script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=false, timeout=15, tag=YT-ad-break

# 原生下载（响应）
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$ script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js, requires-body=true, binary-body-mode=true, timeout=30, tag=YT-download, argument={"nativeDownload":{nativeDownload}}

# player 请求（原生下载相关）
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$ script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15, tag=YT-download-player, argument={"nativeDownload":{nativeDownload}}

# 主响应增强（去广告 / UI / 画质等）
http-response ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config)(?:\?.*)?$ script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js, requires-body=true, binary-body-mode=true, timeout=30, tag=YT-response, argument={"blockUpload":{blockUpload},"blockShorts":{blockShorts},"blockGames":{blockGames},"blockVerticalLive":{blockVerticalLive},"jumpAhead":{jumpAhead},"autoHd":{autoHd},"blockStore":{blockStore}}

# initplayback 响应（UMP）
http-response ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-response.js, requires-body=true, binary-body-mode=true, timeout=30, tag=YT-ump, argument={"blockGames":{blockGames},"blockVerticalLive":{blockVerticalLive},"jumpAhead":{jumpAhead},"autoHd":{autoHd},"blockStore":{blockStore}}

# initplayback 请求
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$ script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15, tag=YT-init

# videoplayback 自动高清
http-request ^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15, tag=YT-auto-hd, argument={"autoHd":{autoHd}}

# log_event
http-request ^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event script-path=https://raw.githubusercontent.com/IBL3ND/module/refs/heads/main/youtube-request.js, requires-body=true, binary-body-mode=true, timeout=15, tag=YT-log-event

# 2) 双语字幕（响应）——完整可用
http-response ^https://(?:www|m)\.youtube\.com/api/timedtext(?:\?|$) script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/youtube-dual-subs.js, requires-body=true, timeout=30, tag=YT-DualSubs, argument=subtitle_type={subtitle_type}&show_only_auto_translation={show_only_auto_translation}


# ========== Music 歌词翻译 (1) ==========
http-response ^https?://music\.youtube\.com/youtubei/v1/(?:browse|get_panel)(?:\?|$) script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/http-response3.js, requires-body=true, timeout=30, tag=YouTube Music 歌词翻译, argument=[{subtitle_type},{auto_cc},{show_only_auto_translation},{subtitle_diagnostics},{subtitle_cache_size},{subtitle_source_language},{subtitle_target_language},{subtitle_position},{subtitle_tolerance_ms},{subtitle_offset_ms},{translation_vendor},{translation_attempts},{googlecloud_version},{googlecloud_mode},{googlecloud_auth},{googlecloud_project},{microsoft_version},{microsoft_mode},{microsoft_auth},{microsoft_region},{deepl_version},{deepl_auth},{lyrics_translation},{external_subtitle_url}]

# ========== googleapis browse/get_panel (1) ==========
http-response ^https://youtubei\.googleapis\.com/youtubei/v1/(?:browse|get_panel)(?:\?|$) script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/http-response4.js, requires-body=true, timeout=30, tag=YouTube googleapis browse, argument=[{subtitle_type},{auto_cc},{show_only_auto_translation},{subtitle_diagnostics},{subtitle_cache_size},{subtitle_source_language},{subtitle_target_language},{subtitle_position},{subtitle_tolerance_ms},{subtitle_offset_ms},{translation_vendor},{translation_attempts},{googlecloud_version},{googlecloud_mode},{googlecloud_auth},{googlecloud_project},{microsoft_version},{microsoft_mode},{microsoft_auth},{microsoft_region},{deepl_version},{deepl_auth},{lyrics_translation},{external_subtitle_url}]


[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, tv.youtube.com, s.youtube.com, music.youtube.com
