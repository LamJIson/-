
#!name = YouTube 双语字幕
#!desc = YouTube 自动翻译双语字幕
#!author = ChatGPT
#!tag = YouTube,字幕,翻译

[Argument]
subtitle_type = select,"Translate","Official",type=string,tag=启用类型,desc=选择使用自动翻译字幕或官方字幕
auto_cc = switch,true,type=boolean,tag=自动显示字幕,desc=是否自动开启字幕
show_only_auto_translation = switch,false,type=boolean,tag=只显示翻译字幕,desc=隐藏源语言字幕

[URL Rewrite]
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$2&$4&subtype=Translate$5 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ https://$1$2&subtype=Translate$4 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$3&subtype=Translate$4 302
^https:\/\/((?:www|m)\.youtube\.com\/api\/timedtext\?)tlang=([^&#]+)(#.*)?$ https://$1subtype=Translate$3 302

[Script]
http-response ^https:\/\/(?:www|m)\.youtube\.com\/api\/timedtext(?:\?|$) script-path=https://raw.githubusercontent.com/LamJIson/-/refs/heads/main/Script/translate.js,requires-body=true,timeout=30,tag=YouTube双语字幕,enable=true,argument="subtitle_type=Translate&show_only_auto_translation=false"

[MITM]
hostname = %APPEND% www.youtube.com, m.youtube.com
