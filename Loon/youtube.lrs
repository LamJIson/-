#!name=YouTube去广告及翻译
#!desc=基于稳定版，去除视频播内嵌购推荐卡
#!author=DivineEngine + app2smile + Maasea + ddgksf2013 + Aioneas + Oneasai + ZenmoFeiShi
#!icon=https://resource.wuyra.com/Icon/App_icon/120px/YouTube.png
#!tag=去广告
#!system=iOS iPadOS
#!system_version=15
#!loon_version=3.4.0(962)
#!date=2026-07-30 13:18:00

[Argument]
Types = input,"Official,Translate",tag=[字幕] 启用类型,desc=请选择要添加的字幕选项，如果为标准播放器，则会在字幕选项中新增勾选字幕选项。
Languages[0] = select,"AUTO","ZH","ZH-HANS","ZH-HK","ZH-HANT","EN","ES","JA","KO","DE","FR","TR","KM","AR","ID",tag=[字幕] 主语言（源语言）,desc=当“主语言”字幕存在时，将生成“主语言/副语言（翻译）”与“主语言（外挂）”的字幕或字幕选项。
Languages[1] = select,"ZH","ZH-HANS","ZH-HK","ZH-HANT","EN","EN-US","ES","ES-ES","ES-419","JA","KO","DE","FR","TR","KM","AR","ID",tag=[字幕] 副语言（目标语言）,desc=当“副语言”字幕存在时，将生成“副语言/主语言（官方）”的字幕或字幕选项。
Position = select,"Reverse","Forward",tag=[字幕] 主语言（源语言）字幕位置,desc=主语言（源语言）字幕的显示位置。
Vendor = select,"Google","Microsoft",tag=[翻译器] 服务商API,desc=请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
ShowOnly = switch,false,tag=[翻译器] 只显示翻译字幕,desc=是否仅显示翻译后字幕，不显示源语言字幕。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。
Type = select,"Official","Translate",tag=[字幕] 启用类型,desc=请选择要使用的字幕，双语字幕将使用您选择类型呈现。
Types = input,"Translate",tag=[歌词] 启用类型,desc=请选择要添加的歌词选项，如果为多选，则会自动决定提供的歌词类型。
AutoCC = switch,true,tag=[字幕] 自动显示,desc=是否总是自动开启字幕显示。
Position = select,"Forward","Reverse",tag=[字幕] 主语言（源语言）字幕位置,desc=主语言（源语言）字幕的显示位置。
Vendor = select,"Google","Microsoft",tag=[翻译器] 服务商API,desc=请选择翻译器所使用的服务商API，更多翻译选项请使用BoxJs。
ShowOnly = switch,false,tag=[翻译器] 只显示“自动翻译”字幕,desc=是否仅显示“自动翻译”字幕，不显示源语言字幕。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。
blockUpload=switch,"false","true",tag=隐藏上传按钮,desc=用于隐藏YouTube底栏的上传按钮
blockShorts=switch,"false","true",tag=隐藏短视频按钮,desc=用于隐藏YouTube底栏的Shorts按钮
captionLang=select,"off","zh-Hans","zh-Hant","ja","ko","en",tag=字幕翻译语言,desc=需要把YouTube字幕翻译翻译为何种语言

[Rewrite]
# 使用reject-img减少开销
^https?:\/\/([\w-]+)\.googlevideo\.com\/initplayback(\?.*oad=.+)$ reject-img
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?&ctier=L(&.+?),ctier,(.+) https://$1$2$3 302
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad - reject-200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads - reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) - reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext - reject-200

