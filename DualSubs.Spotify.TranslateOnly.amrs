# 🍿️ DualSubs Spotify — 仅中文翻译（精简版）
# 去掉: External 外部歌词、多类型、LrcVendor、Preference 面板、复杂储存选项

name = Spotify 歌词中文翻译
hostname = api.spotify.com, spclient.wg.spotify.com, spotify.com

[Parameter]
1, 0, bilingual, 双语显示, true=原文+译文，false=仅中文, true, "[true, false]"
1, 0, targetLang, 目标语言, 翻译目标语言, zh-CN, "[zh-CN, zh-TW]"

[Rule]
# 1) 请求：给 color-lyrics 打上 subtype=Translate（JSON）
0, 100, ^https?://(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?/color-lyrics/v2/track/.+\?(.*)format=json, 

# 2) 请求：protobuf 同样打标（若 App 走二进制）
0, 100, ^https?://(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?/color-lyrics/v2/track/\w+\?, 

# 3) 响应：翻译 JSON 歌词为中文
1, 100, ^https?://(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?/color-lyrics/v2/track/.+\?(.*)format=json, 

# 说明: protobuf 完整解析依赖 DualSubs 大包，精简版只保证 format=json 路径
